
set tabsize 4
set tabstospaces
set autoindent

set linenumbers
# set guidestripe 80

set mouse
set multibuffer

# set nohelp
set constantshow
set titlecolor brightwhite,cyan
set statuscolor brightwhite,cyan
set numbercolor cyan
set keycolor cyan
set functioncolor cyan

bind ^S writeout main
bind ^X exit main
bind ^K cut main
bind ^C copy main
bind ^V paste main
bind ^Z undo main
bind ^Y redo main
bind ^F whereis main
bind ^R replace main
bind ^G gotoline main
bind ^O insert main
